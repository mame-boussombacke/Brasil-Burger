@{
    ViewData["Title"] = "Brasil Burger - Accueil";
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/site.css">
    <link rel="stylesheet" href="~/css/home.css">
</head>
<body class="home-page">
    <div class="welcome-container">
        <!-- Logo -->
        <header class="text-center mb-5">
            <h1 class="home-logo">Brasil Burger</h1>
            <p class="home-subtitle">RESTAURANT</p>
        </header>
        
        <!-- Message de bienvenue -->
        <div class="text-center">
            <h2 class="welcome-title">Bienvenue sur Brasil Burger</h2>
            <p class="welcome-subtitle">Spécialiste de burgers artisanaux</p>
            
            <!-- Boutons d'action -->
            <div class="action-buttons">
                <a asp-controller="Home" asp-action="Catalogue" 
                   class="btn btn-continuer">
                    Continuer
                </a>
                
                <div class="auth-options">
                    <a asp-controller="Client" asp-action="Login" 
                       class="btn btn-auth">
                        S'inscrire ou se connecter
                    </a>
                </div>
            </div>
            
            <p class="auth-text mt-4">
                Connectez-vous pour commander et suivre vos commandes
            </p>
        </div>
    </div>
</body>
</html>