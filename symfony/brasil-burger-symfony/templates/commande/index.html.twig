{% extends 'base.html.twig' %}

{% block title %}Commandes{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/commande-list.css') }}">
{% endblock %}

{% block body %}
<h1>Liste des commandes</h1>

<table>
    <thead>
        <tr>
            <th>Client</th>
            <th>Date</th>
            <th>Type</th>
            <th>Statut</th>
            <th>Montant</th>
        </tr>
    </thead>
    <tbody>
    {% for commande in commandes %}
        <tr>
            <td>
                {{ commande.client.nom }}
                {{ commande.client.prenom }}
            </td>
            <td>{{ commande.dateCommande|date('d/m/Y H:i') }}</td>
            <td>{{ commande.typeLivraison }}</td>
            <td>
                <span class="status {{ commande.statut }}">
                    {{ commande.statut }}
                </span>
            </td>
            <td>{{ commande.montantTotal }} FCFA</td>
        </tr>
    {% else %}
        <tr>
            <td colspan="5">Aucune commande</td>
        </tr>
    {% endfor %}
    </tbody>
</table>
{% endblock %}
