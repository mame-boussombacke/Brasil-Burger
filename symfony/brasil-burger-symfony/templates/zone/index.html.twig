{% extends 'base.html.twig' %}

{% block title %}Zones{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('css/zone-list.css') }}">
{% endblock %}

{% block body %}
<h1>Zones de livraison</h1>

<table>
    <tr>
        <th>Nom</th>
        <th>Prix</th>
    </tr>
    {% for zone in zones %}
    <tr>
        <td>{{ zone.nom }}</td>
        <td>{{ zone.prix }} FCFA</td>
    </tr>
    {% else %}
    <tr>
        <td colspan="2">Aucune zone</td>
    </tr>
    {% endfor %}
</table>
{% endblock %}
