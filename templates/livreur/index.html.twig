{% extends 'base.html.twig' %}

{% block title %}Livreurs{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('css/livreur-list.css') }}">
{% endblock %}

{% block body %}
<h1>Livreurs</h1>

<table>
    <tr>
        <th>Nom</th>
        <th>Téléphone</th>
    </tr>
    {% for livreur in livreurs %}
    <tr>
        <td>{{ livreur.nom }}</td>
        <td>{{ livreur.telephone }}</td>
    </tr>
    {% else %}
    <tr>
        <td colspan="2">Aucun livreur</td>
    </tr>
    {% endfor %}
</table>
{% endblock %}
